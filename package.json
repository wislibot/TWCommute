{
  "name": "twcommute",
  "private": true,
  "description": "Multilingual multimodal transit planner for Taiwan (MRT, rail, bus, YouBike) with multi-stop days.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:ingest": "pnpm --filter @twc/ingest dev",
    "dev:api": "pnpm --filter @twc/api dev",
    "dev:mobile": "pnpm --filter @twc/mobile start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
