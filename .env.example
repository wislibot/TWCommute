# Copy to .env (never commit it). Used by infra/docker-compose.yml and local dev.

# TDX member center → API keys (https://tdx.transportdata.tw/user/dataservice/key)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Requests/minute allowed for your TDX plan (free member plan: 5).
TDX_RATE_PER_MINUTE=5

# infra/scripts/try-it.sh: where the app's API listens. Unset, the phone connects to this computer
# directly over the home network; 127.0.0.1 keeps it on this computer only, for a server the phone
# reaches through an SSH tunnel from a laptop (docs/TRY_IT.md).
# API_HOST=127.0.0.1

# Access key for the app's API (optional). When set, the app needs it in Settings → Server; anyone on
# the network without it gets "unauthorized". Make one with: openssl rand -hex 16
# API_TOKEN=

# Shared secret between api and ingest for /internal/* routes.
INTERNAL_TOKEN=change-me

# Which cities to poll ("all" or a comma list of TDX city names, e.g. Taipei,NewTaipei).
# These defaults fit the free plan; all cities at 30-60 s freshness need ~60 requests/minute.
# They are for docker compose and manual runs: infra/scripts/try-it.sh sets the cities for its regions.
BUS_CITIES=Taipei
BIKE_CITIES=Taipei
BUS_INTERCITY=false
# With BUS_INTERCITY=true, which intercity routes to poll ETAs for: empty for the whole national feed,
# "auto" for those in the GTFS that ingest indexes (a region's trimmed feed via GTFS_INDEX_PATH),
# or a comma list of RouteUIDs (e.g. THB5608,THB9003).
# BUS_INTERCITY_ROUTES=auto

# Polling intervals (seconds). TDX usage depends on these, not on the number of users.
BUS_ETA_INTERVAL_S=60
BIKE_AVAILABILITY_INTERVAL_S=120
TRA_DELAY_INTERVAL_S=120

# OTP JVM heap. All of Taiwan needs a large heap; a Greater Taipei extract fits in ~6g.
OTP_HEAP=12g
OTP_BUILD_HEAP=24g
