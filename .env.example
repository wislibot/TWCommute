# Copy to .env (never commit it). Used by infra/docker-compose.yml and local dev.

# TDX member center → API keys (https://tdx.transportdata.tw/user/dataservice/key)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Requests/second allowed for your TDX subscription tier.
TDX_RATE_PER_SECOND=5

# Shared secret between api and ingest for /internal/* routes.
INTERNAL_TOKEN=change-me

# Which cities to poll ("all" or a comma list of TDX city names, e.g. Taipei,NewTaipei).
BUS_CITIES=all
BIKE_CITIES=all
BUS_INTERCITY=true

# Polling intervals (seconds). TDX usage depends on these, not on the number of users.
BUS_ETA_INTERVAL_S=30
BIKE_AVAILABILITY_INTERVAL_S=60
TRA_DELAY_INTERVAL_S=60

# OTP JVM heap. All of Taiwan needs a large heap; a Greater Taipei extract fits in ~6g.
OTP_HEAP=12g
OTP_BUILD_HEAP=24g
