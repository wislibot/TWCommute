{
  "expo": {
    "name": "TWCommute",
    "slug": "twcommute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "twcommute",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.twcommute"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.twcommute"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TWCommute uses your location to plan trips from where you are and show nearby stops and YouBike stations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "# Shrink unused library code only: no renaming, and React Native, Expo and MapLibre classes kept whole.\n-dontobfuscate\n-keep class com.facebook.** { *; }\n-keep class expo.modules.** { *; }\n-keep class org.maplibre.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.th3rdwave.** { *; }\n-keep class com.reactnativecommunity.** { *; }\n-keep class org.reactnative.** { *; }\n-keep class app.twcommute.** { *; }\n-keep class kotlin.Metadata { *; }\n-keep class kotlin.reflect.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
